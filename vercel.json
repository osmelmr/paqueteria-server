{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "builds": [
    {
      "src": "dist/src/serverless.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/src/serverless.js"
    }
  ],
  "functions": {
    "dist/src/serverless.js": {
      "maxDuration": 60
    }
  }
}
