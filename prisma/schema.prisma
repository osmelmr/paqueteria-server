// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── GUIDES (guías) ──────────────────────────────────
model Guide {
  id           String    @id @default(uuid()) @db.Uuid
  externalRef  String    @map("external_ref") @db.VarChar(255)
  agency       String    @db.VarChar(100)
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz()
  packages     Package[]

  @@map("guides")
}

// ── RECIPIENTS (destinatarios) ──────────────────────
model Recipient {
  id        String    @id @default(uuid()) @db.Uuid
  fullName  String    @map("full_name") @db.VarChar(255)
  idCard    String    @unique @map("id_card") @db.VarChar(50)
  phone     String?   @db.VarChar(50)
  address   String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  packages  Package[]

  @@map("recipients")
}

// ── PROVINCES (provincias) ──────────────────────────
model Province {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(100)
  packages Package[]

  @@map("provinces")
}

// ── STATUSES (estados) ──────────────────────────────
model Status {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @db.VarChar(50)
  category String    @db.VarChar(50)
  packages Package[]

  @@map("statuses")
}

// ── LOCATIONS (ubicaciones) ─────────────────────────
model Location {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @db.VarChar(100)
  type     String    @db.VarChar(50)
  packages Package[]

  @@map("locations")
}

// ── PACKAGES (paquetes/bultos) ──────────────────────
model Package {
  id                 String       @id @default(uuid()) @db.Uuid
  guideId            String?      @map("guide_id") @db.Uuid
  recipientId        String?      @map("recipient_id") @db.Uuid
  provinceId         String?      @map("province_id") @db.Uuid
  addressDetail      String?      @map("address_detail") @db.Text
  weight             Decimal?     @db.Decimal(10, 2)
  contentDescription String?      @map("content_description") @db.Text
  departureDate      DateTime?    @map("departure_date") @db.Date
  arrivalDate        DateTime?    @map("arrival_date") @db.Date
  statusId           String       @map("status_id") @db.Uuid
  locationId         String?      @map("location_id") @db.Uuid
  isOrphan           Boolean      @default(false) @map("is_orphan")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  guide     Guide?      @relation(fields: [guideId], references: [id])
  recipient Recipient?  @relation(fields: [recipientId], references: [id])
  province  Province?   @relation(fields: [provinceId], references: [id])
  status    Status      @relation(fields: [statusId], references: [id])
  location  Location?   @relation(fields: [locationId], references: [id])
  hbls      PackageHbl[]

  @@map("packages")
}

// ── PACKAGE HBLS (códigos HBL por paquete) ──────────
model PackageHbl {
  id        String   @id @default(uuid()) @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  hblCode   String   @map("hbl_code") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  package Package @relation(fields: [packageId], references: [id])

  @@unique([packageId, hblCode])
  @@unique([hblCode])
  @@map("package_hbls")
}
