// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STOREKEEPER
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String?  @unique @db.VarChar(255)
  username  String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  fullName  String?  @map("full_name") @db.VarChar(255)
  role      UserRole @default(STOREKEEPER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique @db.VarChar(500)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}

// ── GUIDES (guías) ──────────────────────────────────
model Agency {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique @db.VarChar(100)
  guides  Guide[]
  type    GuideType
  @@map("agencies")
}

enum GuideType {
  AEREA
  MARITIMA
}

model Guide {
  id           String    @id @default(uuid()) @db.Uuid
  externalRef  String   @unique @map("external_ref") @db.VarChar(255)
  agencyId     String    @map("agency_id") @db.Uuid
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz()
  agency       Agency    @relation(fields: [agencyId], references: [id])
  packages     Package[]

  @@map("guides")
}

// ── RECIPIENTS (destinatarios) ──────────────────────
model Recipient {
  id        String    @id @default(uuid()) @db.Uuid
  fullName  String?    @map("full_name") @db.VarChar(255)
  idCard    String?    @unique @map("id_card") @db.VarChar(50)
  phone     String?   @db.VarChar(50)
  packages  Package[]

  @@map("recipients")
}

// ── PROVINCES (provincias) ──────────────────────────
model Province {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(100)
  packages Package[]
  @@map("provinces")
}

model Municipe {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(100)
  packages Package[]
  @@map("municipes")
}

// ── STATUSES (estados) ──────────────────────────────
model Status {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String                 @unique @db.VarChar(50)
  packages        Package[]
  packageStatuses PackageStatusHistory[]

  @@map("statuses")
}

model PackageStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  statusId  String   @map("status_id") @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  status  Status  @relation(fields: [statusId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])

  @@index([packageId])
  @@index([statusId])
  @@map("package_status_history")
}

// ── LOCATIONS (ubicaciones) ─────────────────────────
model Location {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique @db.VarChar(100)
  packages Package[]
  packageStatuses PackageStatusHistory[]
  @@map("locations")
}

// ── PACKAGES (paquetes/bultos) ──────────────────────
model Package {
  id                 String       @id @default(uuid()) @db.Uuid
  guideId            String?      @map("guide_id") @db.Uuid
  recipientId        String?      @map("recipient_id") @db.Uuid
  provinceId         String?      @map("province_id") @db.Uuid
  municipeId         String?      @map("municipe_id") @db.Uuid

  address            String?      @map("address") @db.Text
  weight             Decimal?     @db.Decimal(10, 2)
  content            String?      @map("content") @db.Text
  anotations         String?      @map("anotations") @db.Text
  alert              Boolean?     @default(false) @db.Boolean
  alertDescription   String?      @map("alert_description") @db.Text

  arrivalDate        DateTime?    @map("arrival_date") @db.Date

  statusId           String       @map("status_id") @db.Uuid
  locationId         String?      @map("location_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  guide     Guide?      @relation(fields: [guideId], references: [id])
  recipient Recipient?  @relation(fields: [recipientId], references: [id])
  province  Province?   @relation(fields: [provinceId], references: [id])
  municipe  Municipe?   @relation(fields: [municipeId], references: [id])
  status    Status      @relation(fields: [statusId], references: [id])
  location  Location?   @relation(fields: [locationId], references: [id])
  hbls      PackageHbl[]
  statuses  PackageStatusHistory[]

  //ruta
  routeId     String?  @map("route_id") @db.Uuid
  route       Route?   @relation(fields: [routeId], references: [id])
  

  @@map("packages")
}

// ── PACKAGE HBLS (códigos HBL por paquete) ──────────
model PackageHbl {
  id        String   @id @default(uuid()) @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  hblCode   String   @map("hbl_code") @db.VarChar(100)

  package Package @relation(fields: [packageId], references: [id])

  @@unique([packageId, hblCode])
  @@unique([hblCode])
  @@map("package_hbls")
}

//ruta
model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)   // Nombre o placa
  isActive  Boolean  @default(true) @map("is_active")
  drivers   DriverVehicle[]
  routes    Route[]
  @@map("vehicles")
}

model Driver {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  routes   RouteDriver[]
  vehicles  DriverVehicle[]
  @@map("drivers")
}

// Tabla intermedia para muchos a muchos entre Vehicle y Driver
model DriverVehicle {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  @@unique([vehicleId, driverId])
  @@map("driver_vehicles")
}

model Route {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  departureDate DateTime @map("departure_date") @db.Timestamptz()
  vehicleId   String   @map("vehicle_id") @db.Uuid
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  packages    Package[]
  drivers   RouteDriver[]
  @@map("routes")
}

model RouteDriver {
  id        String   @id @default(uuid()) @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary") // Para marcar conductor principal
  
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  
  @@unique([routeId, driverId])
  @@map("route_drivers")
}
