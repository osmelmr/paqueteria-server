# Copia este archivo a .env y rellena los valores reales (nunca subas .env a git)

# PostgreSQL (local con docker-compose o Neon/Supabase en produccion)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paqueteria?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=paqueteria

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Origenes permitidos por CORS, separados por coma (dejar vacio = permitir todos, solo para demo)
CORS_ORIGIN=

PORT=5000
